{
  "name": "biu-cs-planner",
  "version": "0.0.1",
  "description": "A local course planner for Bar-Ilan University Computer Science students: a degree Plan across Semesters and a Timetable per Academic Year. Early work in progress, not yet usable.",
  "keywords": [
    "bar-ilan",
    "biu",
    "university",
    "course-planner",
    "timetable",
    "degree-planner",
    "scheduler",
    "hebrew"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Cub11k/biu-cs-planner#readme",
  "bugs": {
    "url": "https://github.com/Cub11k/biu-cs-planner/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cub11k/biu-cs-planner.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "core",
    "app",
    "server",
    "web"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:server": "node --experimental-strip-types server/src/serve.ts",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
